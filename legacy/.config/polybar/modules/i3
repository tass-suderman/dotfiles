[module/i3]
type = internal/i3

pin-workspaces = false

show-urgent = true

strip-wsnumbers = true

index-sort = true

enable-click = true

enable-scroll = false
wrapping-scroll = false
reverse-scroll = false

fuzzy-match = true
ws-icon-0 = 1;󰋜
ws-icon-1 = 2;󰖟
ws-icon-2 = 3;󰙯
ws-icon-3 = 4;󰓇
ws-icon-4 = 5;
ws-icon-5 = 6; 
ws-icon-6 = 7;7
ws-icon-7 = 8;8
ws-icon-8 = 9;9
ws-icon-9 = 0;

ws-icon-default = ♟
; NOTE: You cannot skip icons, e.g. to get a ws-icon-6
; you must also define a ws-icon-5.
; NOTE: Icon will be available as the %icon% token inside label-*

; Available tags:
;   <label-state> (default) - gets replaced with <label-(focused|unfocused|visible|urgent)>
;   <label-mode> (default)
format = <label-state> <label-mode>

; Available tokens:
;   %mode%
; Default: %mode%
label-mode = %mode%
label-mode-padding = 0
label-mode-background = #cc0000

; Available tokens:
;   %name%
;   %icon%
;   %index% -- The index of the WS
;   %output% -- The monitor that shows the WS
; Default: %icon% %name%
label-focused = %icon%
label-focused-foreground = ${colors.primary}
; label-focused-background = #ffdddd
label-focused-underline = ${colors.focused-underline}
label-focused-padding = 3
label-focused-margin = 

; Available tokens:
;   %name%
;   %icon%
;   %index%
;   %output%
; Default: %icon% %name%
label-unfocused = %icon%
label-unfocused-padding = 3
label-unfocused-underline = ${colors.unfocused-underline}
label-unfocused-foreground = ${colors.unfocused-foreground}
label-unfocused-margin = 1

; Available tokens:
;   %name%
;   %icon%
;   %index%
;   %output%
; Default: %icon% %name%
label-visible = %icon%
label-visible-underline = ${colors.visible-underline}
label-visible-foreground = ${colors.visible-foreground}
label-visible-padding = 3 
label-visible-margin = 1

; Available tokens:
;   %name%
;   %icon%
;   %index%
;   %output%
; Default: %icon% %name%
label-urgent = %index%
label-urgent-foreground = #000000
label-urgent-background = #bd2c40
label-urgent-padding = 4

; Separator in between workspaces
label-separator = 
label-separator-padding = 0 
label-separator-foreground = #ffb52a


