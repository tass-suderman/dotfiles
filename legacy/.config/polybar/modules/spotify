
[module/spotify]
type = custom/script
interval = 1
;format-prefix = " "
format = <label>
exec = python ~/.config/polybar/polybar-scripts/polybar-spotify/polybar-spotify.py -f '{play_pause} {song} - {artist}' -p ',' --playpause-font=1 -t 50
format-underline = ${colors.spotify}
;control players (optional)
click-left = playerctl --player=spotify play-pause 
click-right = playerctl --player=spotify next 
click-middle = playerctl --player=spotify previous
